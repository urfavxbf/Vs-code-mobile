<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config
    - Disallows cleartext traffic and trusts Android's up-to-date system CAs.
    - SSL errors are rejected by CodespacesWebViewClient.
    - Do not add static certificate pins without a rotation and backup-pin policy.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- GitHub endpoints: HTTPS with Android platform certificate validation. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">api.github.com</domain>
        <domain includeSubdomains="true">github.githubassets.com</domain>
        <domain includeSubdomains="true">avatars.githubusercontent.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- GitHub Codespaces domain -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">githubpreview.dev</domain>
        <domain includeSubdomains="true">app.github.dev</domain>
        <domain includeSubdomains="true">github.dev</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
